   "notes": [
    "Each socket: + to bar 3, − to bar 4, A (blue) to bar 5, B (white) to bar 6, on the screw with the socket's number (bars 5 / 6: screws 4–7).",
    "Ring lugs (#8) on every screw, 15 in-lb. Socket 5 is the spare: bar 3 / 4 screw 5. Blue is always A, white is always B."
   ]
  },
  {
   "title": "Booster onto bars 2, 3, 4 and the Crydom",
   "wires": [
    23,
    24,
    25,
    26
   ],
   "notes": [
    "The booster's leads come out toward bars 3 and 4: yellow to bar 3 stud A, the black beside it to bar 4 stud A (#10 ring lugs, 18 in-lb).",
    "The booster has two blacks: the one paired with its red goes to bar 2 screw 6; the one paired with its yellow goes to bar 4.",
    "Its red goes to Crydom screw 2."
   ]
  },
  {
   "title": "Relay board",
   "wires": [
    14,
    15,
    16,
    17,
    18,
    19
   ],
   "notes": [
    "Screws 1 (+) and 2 (−) from bars 1 and 2; 3 (A) and 4 (B) from bars 5 and 6; 7 (CH7 COM) from its own bar-1 screw; 6 (CH7 NO) green to Crydom screw 3.",
    "Screws 5 (⏚) and 8 (NC) stay empty."
   ]
  },
  {
   "title": "Radio and antenna",
   "wires": [
    10,
    11,
    12,
    13,
    43
   ],
   "notes": [
    "Power from bars 1 / 2 screw 1, A / B from bars 5 / 6 screw 3.",
    "RG58 from the antenna port to the arrester in the left wall."
   ]
  },
  {
   "title": "F2, Crydom and the ground link",
   "wires": [
    20,
    21,
    22,
    9
   ],
   "notes": [
    "Bar 1 screw 6 → F2 (3 A, fuse OUT for now) → Crydom screw 1. Crydom screw 4 to bar 2 screw 3.",
    "16 AWG black from bar 2 stud B to bar 4 stud B: the one common ground between 12 V and 24 V."
   ]
  },
  {
   "title": "Victron LOAD to bars 1 and 2",
   "wires": [
    7,
    8
   ],
   "notes": [
    "12 AWG: LOAD+ to bar 1 stud A, LOAD− to bar 2 stud A (1/4\" ring lugs, 60 in-lb). These two wires are the only feed into the bus."
   ]
  },
  {
   "title": "Battery (Victron before the solar panel)",
   "wires": [
    2,
    3,
    1
   ],
   "notes": [
    "F1 fuse OUT. Fit F1 → BAT+ and BAT− to battery −, then battery + to F1.",
    "Slide the battery into its tray until both latches click. Check BAT+ / BAT− with a meter: about +13 V.",
    "Fit the 15 A fuse. The Victron has to see the battery before the panel is connected (Victron manual)."
   ]
  },
  {
   "title": "Solar panel (breaker OFF)",
   "wires": [
    4,
    5,
    6
   ],
   "notes": [
    "Breaker OFF and the panel covered. Panel + through the gland to the breaker's LINE, breaker LOAD to Victron PV+, panel − straight to PV−.",
    "Uncover the panel, switch the breaker ON: the Victron's charge light comes on."
   ]
  },
  {
   "title": "Check, then power up",
   "wires": [],
   "notes": [
    "Power off, meter on continuity: bar 1 ↔ bar 2 no beep; bar 3 ↔ bar 4 no beep; bar 3 ↔ bar 1 no beep; bar 2 ↔ bar 4 beep; bar 5 ↔ bar 6 no beep.",
    "Fit F2. The radio and relay board light up straight away.",
    "Switch relay CH7 on: the SSR light comes on and bar 3 reads about 24 V against bar 4. Switch it off: 0 V."
   ]
  }
 ],
 "facts": [
  {
   "title": "Stacked on spacers",
   "text": "Each bar pair stands on nylon spacers over the radio, the booster or the SSR. Wire the part underneath before its bars go on."
  },
  {
   "title": "Fused at the battery",
   "text": "F1 15 A within 7 in of the battery + post; F2 3 A feeds the switched sensor rail."
  }
 ],
 "build_order": [
  "Screw the battery tray on, then the radio, booster and SSR. Wire those three first (far ends loose).",
  "Put each bar pair on its spacers, then the Victron, the relay board, the breaker stand and the two fuse holders.",
  "Then the wiring steps above: battery and solar last."
 ]
